{
  "expo": {
    "name": "Nexora Audiophile",
    "slug": "nexora-audiophile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "nexora",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0B12"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#0B0B12"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-secure-store",
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Nexora to read your audio library for offline playback.",
          "audioPermission": "Allow Nexora to access your audio files.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.suryaprakash.nexora.audio",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true
        },
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing"
        ],
        "NSLocalNetworkUsageDescription": "Nexora connects to your self-hosted server on the local network to browse and stream your music.",
        "NSMicrophoneUsageDescription": "Not used. Nexora does not record audio.",
        "NSAppleMusicUsageDescription": "Allow Nexora to read your audio library for playback."
      }
    },
    "android": {
      "package": "dev.suryaprakash.nexora.audio",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}